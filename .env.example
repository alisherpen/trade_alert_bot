# ============ TELEGRAM (Telethon userbot) ============
TG_API_ID=1234567
TG_API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TG_PHONE=+998900000000
TG_SESSION=sessions/+998900000000

# Kimga qo'ng'iroq qilinadi va xabar yuboriladi (@username, +998..., yoki user_id)
ALERT_TARGET=@CBU2025
# Xabarlar ham shu yerga ketadi (bo'sh qolsa ALERT_TARGET ishlatiladi). "me" = Saved Messages
NOTIFY_CHAT=

# Bot buyruqlarini kim bera oladi. Bo'sh = faqat o'zingiz (outgoing xabarlar).
# Vergul bilan: @username1,123456789
ADMINS=

# ============ MT5 (Exness) ============
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Trial15
# terminal64.exe to'liq yo'li (bo'sh qolsa avtomatik topiladi)
MT5_PATH=
SYMBOL=XAUUSD
# Broker simvolni XAUUSDm / XAUUSD.z deb nomlasa ham avtomatik topadi
SYMBOL_AUTODETECT=true

# ============ ALERT MANTIG'I ============
# Oltin uchun 1 pip = 0.1 USD  ->  60 pips = 6.00 USD
PIP_SIZE=0.1
BUFFER_PIPS=60
POLL_INTERVAL=1.0
# Signal bergan zona narx bufer chegarasidan qancha uzoqlashsa qayta "quroliangan" bo'ladi (pips).
# 0 yoki bo'sh = hech qachon avtomatik qayta yoqilmaydi (faqat /rearm bilan).
REARM_PIPS=30
# Qaysi narx bo'yicha tekshirilsin: bid | ask | mid
PRICE_SOURCE=bid

# ============ QO'NG'IROQ ============
CALL_ENABLED=true
# Necha soniya jiringlasin (ko'tarilmasa shundan keyin uziladi)
CALL_RING_SECONDS=25
# Ko'targanidan keyin necha soniyada uzilsin (0 = darhol)
CALL_HANGUP_DELAY=0.0
# Bir alertda necha marta urinib ko'rsin
CALL_RETRIES=2
CALL_RETRY_DELAY=8
# Qo'ng'iroq ichida ovoz eshittirishning maksimal davomiyligi
CALL_MAX_SPEAK_SECONDS=60

# ============ TTS (ovozli xabar) ============
TTS_ENABLED=true
TTS_VOICE=uz-UZ-SardorNeural
TTS_RATE=+10%

# ============ CHART RASM ============
CHART_ENABLED=true
CHART_TIMEFRAME=M15
CHART_BARS=120

# Zonalarni MT5 chartida jonli chizish (ZoneViewer indikatori orqali)
BRIDGE_ENABLED=true

# ============ BOSHQA ============
LOG_LEVEL=INFO
HEARTBEAT_MINUTES=0
